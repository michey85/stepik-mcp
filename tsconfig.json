{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./build",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "node_modules/@modelcontextprotocol/sdk/server/mcp.d.ts",
    "node_modules/@modelcontextprotocol/sdk/server/stdio.d.ts"
  ],
  "exclude": ["node_modules"]
}
